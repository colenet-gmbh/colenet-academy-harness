# Risk rules of this repo, read by we/scripts/risk_paths.py from origin/main only.
# A PR touching a [brake-change] path is `T2 one-way brake-change`: the owner merges it
# by hand (code owner review per .github/CODEOWNERS).
# Grammar: `[section]`, `path <glob>` and `json <file> <key>` lines (risk_paths.py's docstring).

[brake-change]
path .github/CODEOWNERS
path .weside/crew.json
path .weside/risk-paths
# `build.pr_owner: worker` gives process workers the merge rights: switching it loosens trust.
json .weside/config.json build
path we/hooks/hooks.json
path we/hooks/verification_gate.py
path we/scripts/ready_gate.py
path we/scripts/lens_verdict.py
path we/scripts/risk_paths.py
path we/scripts/risk_runner.py
path we/scripts/worker_launch.py
path we/scripts/worker_rights.py
path we/hooks/worker_rights_gate.py
path we/scripts/we-worker
# The worker merge gate trusts `arm_pr.sh --check`, which reads the required names here.
path we/scripts/arm_pr.sh
path we/scripts/required_checks.sh

# Two-way T2: the crew process every session loads; a change goes through the T2 lens panel.
[t2]
path we/process/**
